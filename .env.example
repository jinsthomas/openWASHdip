# Copy to .env (gitignored) and adjust. Local Docker default shown.
# Remote: postgresql+psycopg://user:password@host:5432/openwashdip?sslmode=require
DATABASE_URL=postgresql+psycopg://openwashdip:openwashdip@localhost:5432/openwashdip

# Optional: AI mapping proposer. Leave unset to use the built-in heuristic proposer
# (no network, no key, instant). Any LLM call falls back to the heuristic on error.
#
# Cloud (Anthropic Claude):
# OPENWASHDIP_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# OPENWASHDIP_LLM_MODEL=claude-sonnet-4-6
#
# Local, no key, data stays on your machine (requires a running Ollama with the model
# pulled — e.g. `brew install ollama && ollama pull llama3.1`):
# OPENWASHDIP_LLM_PROVIDER=ollama
# OPENWASHDIP_LLM_MODEL=llama3.1
# OPENWASHDIP_OLLAMA_URL=http://localhost:11434
